{
  "name": "@shumi-ai/mcp",
  "version": "0.1.3",
  "description": "Shumi crypto trade-intelligence MCP server — the market intelligence the shumi CLI provides, for any MCP client.",
  "type": "module",
  "author": "pxeodev",
  "mcpName": "ai.shumi/mcp",
  "bin": {
    "shumi-mcp": "bin/shumi-mcp.js"
  },
  "main": "src/server.js",
  "files": [
    "bin",
    "src",
    "server.json",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/shumi-mcp.js",
    "start:http": "node src/http-server.js",
    "inspect": "npx -y @modelcontextprotocol/inspector node bin/shumi-mcp.js",
    "test": "SHUMI_TELEMETRY=0 node --test",
    "verify": "node verify-live.mjs",
    "verify:remote": "node verify-live.mjs --remote"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "crypto",
    "cryptocurrency",
    "trading",
    "market-data",
    "funding-rates",
    "sentiment",
    "shumi",
    "ai"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayrsascha/shumi-mcp.git"
  },
  "homepage": "https://shumi.ai",
  "bugs": {
    "url": "https://github.com/mayrsascha/shumi-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "posthog-node": "^5.38.6",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0"
  }
}
